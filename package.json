{
  "name": "@cloudscape-design/demos",
  "version": "3.0.0",
  "scripts": {
    "typecheck": "tsc",
    "clean": "rm -rf lib",
    "lint": "eslint .",
    "prepare": "husky install",
    "generate-html": "cross-env THEME=$npm_config_theme node ./scripts/generate-html-files",
    "build:theme": "node ./scripts/build-vite.mjs $npm_config_theme && npm run generate-html",
    "build": "node ./scripts/build-vite.mjs && npm run generate-html --theme=all",
    "start": "node ./scripts/start-dev.mjs",
    "start:theme": "node ./scripts/start-dev.mjs",
    "serve": "node ./scripts/dev-server.js",
    "jest": "node --experimental-vm-modules ./node_modules/.bin/jest -c jest.config.e2e.js",
    "serve-test": "run-p -r serve jest",
    "pretest": "npm-run-all -s clean -p lint typecheck build",
    "test": "npm run test-no-build",
    "test:unit": "node --experimental-vm-modules ./node_modules/.bin/jest -c jest.config.unit.js",
    "test-no-build": "run-s test:unit test:e2e",
    "test:e2e": "cross-env E2E_MAX_WORKERS=50% run-p --continue-on-error --aggregate-output test:default",
    "test:default": "cross-env ALWAYS_VISUAL_REFRESH=true WEBDRIVER_PORT=9515 DEV_SERVER_PORT=9615 npm run serve-test"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@cloudscape-design/board-components": "^3.0.0",
    "@cloudscape-design/browser-test-tools": "^3.0.0",
    "@cloudscape-design/build-tools": "github:cloudscape-design/build-tools#main",
    "@cloudscape-design/chart-components": "^1.0.0",
    "@cloudscape-design/chat-components": "^1.0.0",
    "@cloudscape-design/code-view": "^3.0.0",
    "@cloudscape-design/collection-hooks": "^1.0.0",
    "@cloudscape-design/component-toolkit": "^1.0.0-beta",
    "@cloudscape-design/components": "^3.0.0",
    "@cloudscape-design/design-tokens": "^3.0.0",
    "@cloudscape-design/global-styles": "^1.0.0",
    "@cloudscape-design/test-utils-core": "^1.0.0",
    "@cloudscape-design/theming-runtime": "^1.0.0",
    "@eslint-react/eslint-plugin": "^1.16.1",
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.0",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tony.ganchev/eslint-plugin-header": "^3.3.1",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.14.184",
    "@types/node": "^24.0.0",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.10",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "ace-builds": "^1.32.6",
    "axe-core": "^4.4.3",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^16.1.0",
    "highcharts": "^12.6.2",
    "husky": "^8.0.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^15.4.3",
    "lodash": "^4.18.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.54.5",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^8.3.5",
    "zod": "^4.0.16"
  },
  "browserslist": [
    "last 3 Chrome major versions",
    "last 3 Firefox major versions",
    "last 3 Edge major versions",
    "last 3 Safari versions"
  ],
  "lint-staged": {
    "*.html": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "package-lock.json": [
      "./scripts/clean-package-lock.js"
    ]
  },
  "overrides": {
    "glob": "^10.5.0",
    "@puppeteer/browsers": "^3.2.0",
    "test-exclude": "^7.0.1"
  },
  "private": true
}
